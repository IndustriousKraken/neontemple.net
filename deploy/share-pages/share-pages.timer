[Unit]
# This interval is an EXPOSURE BOUND, not a freshness bound.
#
# Creation latency is already covered: a share page that does not exist yet is
# generated by the loopback responder on the first request for it, and the copy
# control primes it before the link is ever pasted. So the only thing this
# interval governs is how long a RETRACTED item keeps being served — an operator
# who publishes by mistake and corrects it in seconds must not wait half an hour
# for the public site to agree.
#
# Five minutes, therefore, and not the 30 the yt-feed cache uses: that one is
# refreshing a cache nobody is harmed by finding stale. Changing this number is
# changing how long withdrawn content stays up. It does not reach previews a
# platform already scraped — nothing here can.
Description=Reconcile theneontemple.com share pages every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
